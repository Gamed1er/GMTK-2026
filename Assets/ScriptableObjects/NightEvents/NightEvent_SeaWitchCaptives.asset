  titleZH: "\u6D77\u5996\u7684\u4FD8\u865C"
  titleEN: The Sea Witch's Prisoners
  descriptionZH: "\u4F60\u767C\u73FE\u6D77\u5996\u6B63\u5728\u56DA\u7981\u4E00\u6279\u8239\u54E1\uFF0C\u82E5\u596A\u56DE\u4ED6\u5011\uFF0C\u6D77\u5996\u6703\u653B\u64CA\u8239\u8EAB\u3002\n\n[\u596A\u56DE]
    \u8239\u54E1 +6 / \u8239\u9AD4 -40 / \u98DF\u7269 -10\n[\u653E\u68C4] \u8239\u9AD4
    -5"
  descriptionEN: 'You spot a sea witch holding captives. Rescuing them means taking
    hull damage in the fight.


    [Rescue] Crew +6 / Ship HP -40 / Food -10

    [Flee]
    Ship HP -5'
  acceptLabelZH: "\u596A\u56DE"
  acceptLabelEN: Rescue
  rejectLabelZH: "\u653E\u68C4"
  rejectLabelEN: Flee
