  m_Name: NightEvent_StarvedChoice
  m_EditorClassIdentifier: 
  type: 9
  titleZH: "\u98E2\u9913\u7684\u6289\u64C7"
  titleEN: A Desperate Trade
  descriptionZH: "\u8239\u96BB\u9700\u8981\u4FEE\u7E55\uFF0C\u4F46\u4F60\u4E5F\u9700\u8981\u98DF\u7269\u3002\n\u6709\u4EBA\u8AAA\uFF1A\u628A\u4FEE\u8239\u6750\u6599\u6254\u9032\u6D77\u88E1\u63DB\u53D6\u98DF\u7269\uFF0C\u4F60\u540C\u610F\u55CE\uFF1F\n\n[\u540C\u610F]
    \u98DF\u7269 +30 / \u8239\u9AD4 -40\n[\u62D2\u7D55] \u8239\u9AD4 -5 / \u98DF\u7269
    +5"
  descriptionEN: 'The ship needs repairs, but the crew needs food.

    Someone suggests
    dumping repair materials to trade for food. Do you agree?


    [Agree] Food
    +30 / Ship HP -40

    [Refuse] Ship HP -5 / Food +5'
  acceptLabelZH: "\u540C\u610F"
  acceptLabelEN: Agree
  rejectLabelZH: "\u62D2\u7D55"
  rejectLabelEN: Refuse
  acceptDelta:
    food: 30
    crew: 0
    shipHP: -40
    navProgress: 0
  rejectDelta:
    food: 5
    crew: 0
    shipHP: -5
    navProgress: 0
  spawnWeight: 1
  canReject: 1
