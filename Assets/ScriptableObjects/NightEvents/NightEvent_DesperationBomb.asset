  type: 11
  titleZH: "\u7D55\u671B\u7684\u8089\u5F48"
  titleEN: Bombs of Despair
  descriptionZH: "\u4F60\u7684\u8239\u88AB\u56F0\u4F4F\u4E86\uFF0C\u5E7E\u500B\u8239\u54E1\u81EA\u9858\u8DF3\u4E0A\u6575\u8239\u5F15\u7206\u70B8\u85E5\u3002\n\u4F60\u662F\u5426\u963B\u6B62\u4ED6\u5011\uFF1F\n\n[\u8B93\u4ED6\u5011\u53BB]
    \u8239\u9AD4 +30 / \u8239\u54E1 -4\n[\u963B\u6B62] \u8239\u54E1 -1 / \u8239\u9AD4
    -10"
  descriptionEN: 'Your ship is pinned. Some crew volunteer to leap onto the enemy
    ship and detonate explosives.

    Do you stop them?


    [Let Them] Ship HP
    +30 / Crew -4

    [Stop Them] Crew -1 / Ship HP -10'
  acceptLabelZH: "\u8B93\u4ED6\u5011\u53BB"
  acceptLabelEN: Let Them
  rejectLabelZH: "\u963B\u6B62"
  rejectLabelEN: Stop Them
  acceptDelta:
    food: 0
    crew: -4
    shipHP: 30
    navProgress: 0
  rejectDelta:
